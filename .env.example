# -------------------------------------------------------------
# 🔥 FIREBASE & BACKEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# Copy this file to .env and fill in your private values
# -------------------------------------------------------------
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID

# Production Site URL for Canonical URLs, Sitemap & OpenGraph Metadata
VITE_SITE_URL=https://pylearnnotebook.com

# Backend Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=your_super_secret_jwt_key_here
